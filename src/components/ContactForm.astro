---
// 这是联系我们表单组件
---

<div class="contact-form-container">
  <h3>在线表单咨询</h3>
  <p>填写您的需求，我们的技术专家将在24小时内与您联系。</p>
  <form id="contact-form">
    <div class="form-group">
      <label for="name">联系人姓名</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        placeholder="请输入您的姓名"
      />
    </div>
    <div class="form-group">
      <label for="contact">联系方式 (手机号或邮箱)</label>
      <input
        type="text"
        id="contact"
        name="contact"
        required
        placeholder="请输入您的联系方式"
      />
    </div>
    <div class="form-group">
      <label for="reason">咨询原因 / 需求描述</label>
      <textarea
        id="reason"
        name="reason"
        rows="4"
        required
        placeholder="请简要描述您的测试需求或咨询问题..."></textarea>
    </div>
    <button type="submit" class="submit-btn">提交咨询</button>
  </form>
  <div id="form-status" class="status-message"></div>
</div>

<style>
  .contact-form-container {
    margin-top: 3rem;
    padding: 2rem;
    background-color: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
  }
  .contact-form-container h3 {
    margin-top: 0;
  }
  .form-group {
    margin-bottom: 1.25rem;
  }
  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: var(--sl-color-white);
  }
  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-hairline-shade, var(--sl-color-hairline));
    border-radius: 0.25rem;
    background-color: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-family: inherit;
    box-sizing: border-box;
  }
  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--sl-color-text-accent);
    box-shadow: 0 0 0 1px var(--sl-color-text-accent);
  }
  .submit-btn {
    background-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-invert);
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 0.25rem;
    cursor: pointer;
    font-weight: bold;
    font-size: 1rem;
    transition: opacity 0.2s;
  }
  .submit-btn:hover {
    opacity: 0.9;
  }
  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .status-message {
    margin-top: 1rem;
    padding: 1rem;
    border-radius: 0.25rem;
    display: none;
  }
  .status-message.success {
    display: block;
    background-color: rgba(46, 160, 67, 0.15);
    color: #3fb950;
    border: 1px solid rgba(46, 160, 67, 0.4);
  }
  .status-message.error {
    display: block;
    background-color: rgba(248, 81, 73, 0.1);
    color: #f85149;
    border: 1px solid rgba(248, 81, 73, 0.4);
  }
</style>

<script>
  // ==========================================
  // Directus 配置区域
  // ==========================================
  // 请在此处替换为你的 Directus 实例的 URL
  const DIRECTUS_URL = "http://localhost:8055";

  // 这是你在后台创建的 "inquiries" 表单的真实 ID
  // 刚才我已经帮你查出来了
  const FORM_ID = "aecf114c-0da9-4f7a-b161-0cc6d8ed5d37";

  // 如果你的 Directus 集合不是公开可创建的，你需要在这里提供一个有权限的静态 Token
  const DIRECTUS_TOKEN = "wvEyrh2kfaGcZA0dG5TgLwY74oc3mYqU";
  // ==========================================

  const form = document.getElementById("contact-form");
  const statusMessage = document.getElementById("form-status");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "提交中...";
      }
      statusMessage.className = "status-message";

      const formData = new FormData(form);

      try {
        // 第一步：动态获取这个表单对应的所有字段 UUID (避免写死)
        const fieldsResponse = await fetch(
          `${DIRECTUS_URL}/items/form_fields?filter[form][_eq]=${FORM_ID}`,
          {
            headers: {
              Authorization: `Bearer ${DIRECTUS_TOKEN}`,
            },
          }
        );
        if (!fieldsResponse.ok) throw new Error("无法获取表单字段配置");
        const fieldsData = await fieldsResponse.json();

        // 创建 field_name -> field_id 的映射
        const fieldMap = {};
        fieldsData.data.forEach((f) => {
          fieldMap[f.name] = f.id;
        });

        // 第二步：构造符合后台要求的数据格式
        const values = [];
        for (const [key, value] of formData.entries()) {
          if (fieldMap[key]) {
            values.push({
              field: fieldMap[key],
              value: value,
            });
          }
        }

        const submitData = {
          form: FORM_ID,
          values: values,
        };

        // 第三步：提交到 form_submissions 集合
        const response = await fetch(`${DIRECTUS_URL}/items/form_submissions`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${DIRECTUS_TOKEN}`,
          },
          body: JSON.stringify(submitData),
        });

        if (!response.ok) {
          const errData = await response.json();
          console.error("提交失败详情:", errData);
          throw new Error(`提交失败: ${response.status}`);
        }

        // 提交成功
        statusMessage.textContent = "提交成功！我们将尽快与您联系。";
        statusMessage.className = "status-message success";
        form.reset();
      } catch (error) {
        console.error("表单提交错误:", error);
        statusMessage.textContent =
          "提交失败，请稍后重试或通过电话联系我们。确保 Directus 服务正常且允许跨域请求(CORS)。";
        statusMessage.className = "status-message error";
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "提交咨询";
        }
      }
    });
  }
</script>
